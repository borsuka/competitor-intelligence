# Sentinel — environment configuration
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------- application
ENVIRONMENT=development           # development | test | production
DEBUG=true
APP_NAME=Sentinel
PUBLIC_WEB_URL=http://localhost:3000

# ------------------------------------------------------------------- security
# REQUIRED. 32+ random characters. The app refuses to start in production without it.
SECRET_KEY=dev-insecure-secret-change-me
# Optional second factor for password hashing, kept outside the database so that a
# stolen dump alone cannot be cracked offline. Changing it invalidates all passwords.
PASSWORD_PEPPER=

ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days

COOKIE_SECURE=false                   # MUST be true in production (HTTPS only)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com       # set when the API and web app share a domain

# Comma separated. The web origin(s) allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- database
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Used by docker-compose to provision the postgres container.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# ---------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Default to REDIS_URL when unset.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ------------------------------------------------------------------------- ai
# mock      — deterministic development output, clearly labelled everywhere it appears.
# anthropic — real analysis. Requires ANTHROPIC_API_KEY.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Extraction is reading comprehension and runs on the cheaper model; synthesis and
# comparison run on the stronger one.
AI_MODEL_EXTRACTION=claude-haiku-4-5-20251001
AI_MODEL_SYNTHESIS=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=60000

# Embeddings. Without VOYAGE_API_KEY the app uses a local lexical hashing embedder:
# real and deterministic, but lexical rather than semantic. Search results say so.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024   # must match the model; changing it requires a migration

# -------------------------------------------------------------------- crawler
# Identify the crawler honestly and give site owners a way to reach you.
SCRAPER_USER_AGENT=SentinelBot/0.1 (+https://github.com/borsuka/competitor-intelligence; competitor intelligence crawler)
SCRAPER_ENABLE_JS=false           # true needs the 'js' extra + playwright install chromium
SCRAPER_MAX_PAGES=25
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_BYTES=2000000
SCRAPER_MAX_REDIRECTS=5
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_DELAY_SECONDS=1.0
# DANGER: disables the SSRF guard. Tests only; production startup refuses it.
SCRAPER_ALLOW_PRIVATE_NETWORKS=false

# --------------------------------------------------------------------- quotas
QUOTA_COMPETITORS=25
QUOTA_ANALYSES_PER_MONTH=200
QUOTA_PAGES_PER_MONTH=5000
QUOTA_AI_TOKENS_PER_MONTH=5000000

# --------------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_ANALYSIS_PER_HOUR=30
RATE_LIMIT_READ_PER_MINUTE=300

# ------------------------------------------------------------------ monitoring
MONITORING_DEFAULT_INTERVAL_HOURS=24
MONITORING_BATCH_SIZE=50

# --------------------------------------------------------------- observability
LOG_LEVEL=INFO
LOG_FORMAT=console                # console | json (use json in production)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ----------------------------------------------------------------------- email
# Not implemented: notifications are stored in-app and logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@sentinel.local

# ------------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
